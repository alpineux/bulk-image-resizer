{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulk Image Resizer",
  "version": "0.1.0",
  "identifier": "com.jasonleyser.bulk-image-resizer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bulk Image Resizer",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "backgroundColor": "#070807"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Resize and optimize images in bulk on your Mac.",
    "longDescription": "Bulk Image Resizer processes images locally on your Mac, with batch resizing and export to common image formats.",
    "copyright": "Copyright © 2026 Jason Leyser",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
